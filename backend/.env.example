# FixTag Backend Configuration
# Comma-separated list of allowed frontend origins for CORS (defaults to http://localhost:5173,http://127.0.0.1:5173 if unset)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database connection URL (defaults to sqlite:///./fixtag.db if unset)
# DATABASE_URL=sqlite:///./fixtag.db
# DATABASE_URL=postgresql://user:password@hostname:5432/fixtag_db

# Discord incoming webhook URL to enable #fix-alerts notifications (optional)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
